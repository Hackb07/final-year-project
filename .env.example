# ============================================================================
# CapsuleAI environment configuration
# Copy this file to `.env` and adjust for your machine.
# Never commit `.env` to version control.
# ============================================================================

APP_ENV=development

# --- Computer vision ---------------------------------------------------------
# Path to the YOLO11 capsule endoscopy model (relative to project root).
YOLO_MODEL_PATH=models/capsule_yolo11.pt
CONFIDENCE_THRESHOLD=0.40

# Device: leave empty for auto (CUDA if available, otherwise CPU)
# DEVICE=cpu

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=data/uploads
OUTPUT_DIR=outputs
LOG_DIR=logs

# --- API ---------------------------------------------------------------------
CORS_ORIGINS=*

# --- LLM / RAG (Milestones 5-6) ----------------------------------------------
# LLM_PROVIDER=openrouter
# LLM_MODEL=
# OPENROUTER_API_KEY=
# VECTOR_DB_PATH=data/chroma
# DATABASE_URL=sqlite:///./data/capsuleai.db

# --- LLM agents (Groq, OpenAI-compatible) ------------------------------------
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
